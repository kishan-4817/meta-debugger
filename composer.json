{
  "name": "meta-debugger/meta-debugger",
  "description": "Inspect WordPress post meta, custom post types, WooCommerce fields, and ACF data with a sleek slide-out tree viewer and instant search.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "WordPress Plugin Developer",
      "homepage": "https://wordpress.org/"
    }
  ],
  "autoload": {
    "psr-4": {
      "MetaDebugger\\": "includes/"
    }
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "^3.8",
    "wp-coding-standards/wpcs": "^3.0",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "szepeviktor/phpstan-wordpress": "^1.3"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "scripts": {
    "lint:php": "phpcs --standard=.phpcs.xml.dist .",
    "fix:php": "phpcbf --standard=.phpcs.xml.dist ."
  }
}
